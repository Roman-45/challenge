@model IEnumerable<CertificateOfAttendance>
@{
    ViewData["Title"] = "Dashboard";
}

<section class="hero">
    <div class="hero-content">
        <h1 class="hero-title">Certificate Dashboard</h1>
        <p class="hero-sub">Manage and generate Certificates of Good Standing</p>
    </div>
</section>

<!-- Metric Cards -->
<div class="metrics">
    <div class="metric-card">
        <span class="metric-icon metric-icon--total">
            <svg viewBox="0 0 24 24" class="ic ic-lg"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </span>
        <div class="metric-body">
            <div class="metric-val">@ViewBag.Total</div>
            <div class="metric-lbl">Total Records</div>
        </div>
    </div>
    <div class="metric-card">
        <span class="metric-icon metric-icon--active">
            <svg viewBox="0 0 24 24" class="ic ic-lg"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
        </span>
        <div class="metric-body">
            <div class="metric-val">@ViewBag.ActiveCount</div>
            <div class="metric-lbl">Active Students</div>
        </div>
    </div>
    <div class="metric-card">
        <span class="metric-icon metric-icon--showing">
            <svg viewBox="0 0 24 24" class="ic ic-lg"><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
        </span>
        <div class="metric-body">
            <div class="metric-val">@Model.Count()</div>
            <div class="metric-lbl">Showing</div>
        </div>
    </div>
</div>

<!-- Filters -->
<form method="get" class="filter-bar">
    <div class="filter-search">
        <svg viewBox="0 0 24 24" class="filter-search-ic"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M21 21l-4.35-4.35" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <input type="text" name="search" value="@ViewBag.Search" placeholder="Search by name or student ID..." class="filter-input" />
    </div>
    <div class="filter-select-wrap">
        <select name="status" class="filter-select">
            <option value="">All Statuses</option>
            <option value="Active" selected="@(ViewBag.Status == "Active")">Active</option>
            <option value="Completed" selected="@(ViewBag.Status == "Completed")">Completed</option>
            <option value="Suspended" selected="@(ViewBag.Status == "Suspended")">Suspended</option>
        </select>
        <svg viewBox="0 0 24 24" class="sel-arrow"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
    <button type="submit" class="btn btn--primary">Search</button>
    @if (!string.IsNullOrEmpty(ViewBag.Search?.ToString()) || !string.IsNullOrEmpty(ViewBag.Status?.ToString()))
    {
        <a asp-action="Index" class="btn btn--outline">Clear</a>
    }
</form>

<!-- Table -->
@if (!Model.Any())
{
    <div class="empty">
        <div class="empty-circle">
            <svg viewBox="0 0 24 24" class="ic ic-xl"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </div>
        <h3>No certificates found</h3>
        <p>Adjust your search or create a new certificate record.</p>
        <a asp-action="Create" class="btn btn--primary btn--lg">Create Certificate</a>
    </div>
}
else
{
    <div class="tbl-wrap">
        <table class="tbl">
            <thead>
                <tr>
                    <th>Student Name</th>
                    <th>Student ID</th>
                    <th>Faculty</th>
                    <th>Major</th>
                    <th>Year</th>
                    <th>Status</th>
                    <th class="th-actions">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td class="cell-name">@c.StudentName</td>
                    <td class="cell-id">@c.StudentID</td>
                    <td>@c.Faculty</td>
                    <td>@c.Major</td>
                    <td>@c.Year</td>
                    <td><span class="pill pill--@c.Status?.ToLower()">@c.Status</span></td>
                    <td class="cell-actions">
                        <a asp-action="Details" asp-route-studentId="@c.StudentID" class="act act--view" title="View">
                            <svg viewBox="0 0 24 24"><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
                        </a>
                        <a asp-action="Edit" asp-route-studentId="@c.StudentID" class="act act--edit" title="Edit">
                            <svg viewBox="0 0 24 24"><path d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </a>
                        <a asp-action="DownloadPdf" asp-route-studentId="@c.StudentID" class="act act--pdf" title="Download PDF" target="_blank">
                            <svg viewBox="0 0 24 24"><path d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </a>
                        <form asp-action="Delete" asp-route-studentId="@c.StudentID" method="post" class="inline-form"
                              onsubmit="return confirm('Delete certificate for @c.StudentName?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="act act--del" title="Delete">
                                <svg viewBox="0 0 24 24"><path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
