<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] &mdash; AUCA Certificate System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Lora:wght@500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>

<header class="topbar">
    <div class="topbar-inner">
        <a class="logo" asp-controller="Certificates" asp-action="Index">
            <img src="~/images/auca-logo.jpeg" alt="AUCA" class="logo-img" />
            <div class="logo-text">
                <span class="logo-name">AUCA</span>
                <span class="logo-desc">Certificate Portal</span>
            </div>
        </a>
        <nav class="topnav">
            <a asp-controller="Certificates" asp-action="Index" class="topnav-link">
                <svg viewBox="0 0 24 24" class="ic"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1h-2z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Dashboard
            </a>
            <a asp-controller="Certificates" asp-action="Create" class="topnav-cta">
                <svg viewBox="0 0 24 24" class="ic"><path d="M12 4v16m-8-8h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                New Certificate
            </a>
        </nav>
    </div>
</header>

<main class="container">
    @if (TempData["Success"] != null)
    {
        <div class="toast toast--ok" role="alert">
            <svg viewBox="0 0 24 24" class="toast-ic"><path d="M5 13l4 4L19 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>@TempData["Success"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="toast toast--err" role="alert">
            <svg viewBox="0 0 24 24" class="toast-ic"><path d="M12 9v4m0 4h.01" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
            <span>@TempData["Error"]</span>
        </div>
    }
    @RenderBody()
</main>

<footer class="site-foot">
    <span>&copy; @DateTime.Now.Year Adventist University of Central Africa &mdash; Directorate for Admissions &amp; Academic Records</span>
</footer>

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="~/js/app.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
